# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Get a key at https://openrouter.ai/keys — set a spend limit on it.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OWN_KEY

# --- Backend selection -------------------------------------------------
# "openrouter"  -> POST {JEVBENCH_DECISIONS_URL}   (default)
# "typesafe"    -> POST https://api.typesafe.ai/v1/systemone  (native, needs TYPESAFE_API_KEY)
# "simulator"   -> fully offline, deterministic, no network and no key
JEVBENCH_BACKEND=openrouter

# The System One decision endpoint. Override if the route moves — it is
# currently an alpha route and is not guaranteed stable.
JEVBENCH_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions

# Pin an exact version for reproducibility rather than the moving alias.
JEVBENCH_MODEL=typesafe/jev-1.13

# Comparison arm: an ordinary autoregressive chat model on the same key.
JEVBENCH_BASELINE_MODEL=anthropic/claude-sonnet-5

# Native TypeSafe API instead of OpenRouter (optional)
# TYPESAFE_API_KEY=
